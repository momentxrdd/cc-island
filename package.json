{
  "name": "cc-island",
  "version": "1.0.0",
  "description": "A Dynamic Island-style Windows overlay for Claude Code sessions: live status, permission approvals, and Spotify controls.",
  "main": "main.js",
  "license": "MIT",
  "author": "moment",
  "keywords": [
    "claude",
    "claude-code",
    "dynamic-island",
    "electron",
    "windows",
    "overlay",
    "spotify"
  ],
  "os": [
    "win32"
  ],
  "engines": {
    "node": ">=18"
  },
  "files": [
    "assets",
    "lib",
    "*.js",
    "*.ps1",
    "*.html",
    "*.css",
    "tray.png"
  ],
  "scripts": {
    "prestart": "node scripts/build-native.js && vite build",
    "start": "electron .",
    "watch": "vite build --watch",
    "postinstall": "node scripts/build-native.js && vite build",
    "install-hooks": "node install-hooks.js",
    "uninstall-hooks": "node install-hooks.js --remove",
    "make-tray": "node make-tray.js",
    "build": "node scripts/build-win.js",
    "build:ui": "vite build",
    "build:native": "node scripts/build-native.js",
    "dist:setup": "node scripts/build-native.js && vite build && electron-builder --win nsis --x64 --publish never",
    "make-icon": "electron scripts/make-icon.js"
  },
  "devDependencies": {
    "@fluentui/svg-icons": "^1.1.344",
    "@sveltejs/vite-plugin-svelte": "^3.1.2",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "fluent-svelte-extra": "^2.2.5",
    "sass": "^1.105.1",
    "svelte": "^4.2.20",
    "svelte-preprocess": "^5.1.4",
    "typescript": "^6.0.3",
    "vite": "^5.4.21"
  },
  "build": {
    "appId": "com.momentxrdd.ccisland",
    "productName": "CC Island",
    "copyright": "MIT",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "asar": false,
    "files": [
      "package.json",
      "main.js",
      "preload.js",
      "hook.js",
      "install-hooks.js",
      "media.js",
      "media.ps1",
      "system.ps1",
      "wincal.ps1",
      "i18n.js",
      "icons.js",
      "island.js",
      "renderer.js",
      "widgets.js",
      "settings.js",
      "pet.js",
      "index.html",
      "style.css",
      "island.css",
      "widgets.css",
      "settings.css",
      "tray.png",
      "assets/**",
      "lib/**",
      "ui/**",
      "bin/cc-helper.exe"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CC Island",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh",
      "artifactName": "CC-Island-Setup-${version}.exe",
      "installerLanguages": [
        "en_US",
        "tr_TR"
      ],
      "multiLanguageInstaller": true
    }
  }
}
